{
  "Lua.workspace.library": [
        "${addons}/garrysmod/module/library"
    ],
  "Lua.runtime.version": "LuaJIT",
  "Lua.runtime.special": {
    "include": "dofile",
    "IncludeCS": "dofile",
    "atomic.loader.client": "dofile",
    "atomic.loader.shared": "dofile",
    "atomic.loader.server": "dofile"
  },
  "Lua.runtime.nonstandardSymbol": [
    "continue",
        "!",
        "!=",
        "&&",
        "||",
        "//",
        "/**/"
  ],
  "Lua.diagnostics.disable": [
    "duplicate-set-field",
    "invisible"
  ],
  "Lua.workspace.checkThirdParty": false,
  "diagnostics.globals": [
      "atomic",
      "git",
      "mysqloo",
      "todo",
      "new",
      "current",
      "async",
      "super"
  ]
}